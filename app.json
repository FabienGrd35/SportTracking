{
  "expo": {
    "name": "SportTracking",
    "slug": "sporttracking",
    "scheme": "sporttracking",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-health-connect",
      "./plugins/withHealthConnectDelegate.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SportTracking lit tes captures d'écran Renpho pour en extraire tes pesées."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "eu.sporttracking.app"
    },
    "android": {
      "package": "eu.sporttracking.app",
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT"
      ]
    }
  }
}
